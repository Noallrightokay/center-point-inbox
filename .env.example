# =============================================================================
# Center Point Inbox — Environment Variables
# Copy this file to .env and customize as needed
# =============================================================================

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
POSTGRES_USER=cpi_admin
POSTGRES_PASSWORD=cpi_dev_password_2024
POSTGRES_DB=center_point_inbox
REDIS_PASSWORD=cpi_redis_password
RABBITMQ_USER=cpi_rabbit
RABBITMQ_PASSWORD=cpi_rabbit_password
MINIO_ROOT_USER=cpi_minio_admin
MINIO_ROOT_PASSWORD=cpi_minio_password

# ---------------------------------------------------------------------------
# JWT (must match across all backend services)
# ---------------------------------------------------------------------------
JWT_ISSUER=CenterPointInbox
JWT_AUDIENCE=CenterPointInboxClient
JWT_SIGNING_KEY=dev-jwt-signing-key-change-in-production-min-32-chars!!
JWT_TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-32ch!!

# ---------------------------------------------------------------------------
# Google OAuth (optional — for Google sign-in & Drive)
# Get credentials: https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ---------------------------------------------------------------------------
# Microsoft OAuth (optional — for Microsoft sign-in & OneDrive)
# Get credentials: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET
MICROSOFT_TENANT_ID=YOUR_MICROSOFT_TENANT_ID

# ---------------------------------------------------------------------------
# OpenAI (optional — for AI assistant features)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Hostinger (optional — for the Hostinger MCP servers in .mcp.json)
# Create a token: hPanel → Account → API. See docs/hostinger-mcp.md
# Not used by the app at runtime; export it in the shell you run Claude from.
# ---------------------------------------------------------------------------
HOSTINGER_API_TOKEN=YOUR_HOSTINGER_API_TOKEN
