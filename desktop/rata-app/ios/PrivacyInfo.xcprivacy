<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RATA's privacy manifest for iOS, put in the app by prepare.sh.

  No tracking and no tracking domains: RATA has neither. The data types it
  collects are the owner's answers in App Store Connect, and go in
  NSPrivacyCollectedDataTypes once given.

  The required-reason APIs are the ones the built program calls, found by
  required-reasons.sh from its undefined symbols and the class and method
  names it asks for. The iOS job fails when they and this list differ.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- C617.1: the size, times and kind of files inside the app's own
		     container (the mailbox list, its lock, saved files). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- 35F9.1: time elapsed between events inside the app (timeouts,
		     how long a check took). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
