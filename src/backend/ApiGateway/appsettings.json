{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "CenterPointInbox.ApiGateway"
    }
  },
  "Jwt": {
    "Issuer": "CenterPointInbox",
    "Audience": "CenterPointInbox",
    "SigningKey": "CHANGE_ME_USE_AT_LEAST_32_BYTES_FOR_HMAC_SHA256",
    "ExpirationMinutes": 15,
    "RefreshExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000;http://localhost:5173"
  },
  "Gateway": {
    "RedisConnectionString": "localhost:6379",
    "HealthCheckTimeoutSeconds": 5,
    "GlobalRateLimit": {
      "MaxRequests": 100,
      "WindowSeconds": 60,
      "IncludeIpInKey": true
    },
    "EndpointRateLimits": {
      "/api/auth/**": {
        "MaxRequests": 20,
        "WindowSeconds": 60,
        "IncludeIpInKey": true
      },
      "/api/ai/**": {
        "MaxRequests": 30,
        "WindowSeconds": 60,
        "IncludeIpInKey": true
      },
      "/api/translate/**": {
        "MaxRequests": 50,
        "WindowSeconds": 60,
        "IncludeIpInKey": true
      },
      "/api/admin/**": {
        "MaxRequests": 200,
        "WindowSeconds": 60,
        "IncludeIpInKey": false
      }
    },
    "Services": {
      "AuthService": "http://auth-service:5001",
      "GoogleProviderService": "http://google-provider:5002",
      "MicrosoftProviderService": "http://microsoft-provider:5003",
      "MergerService": "http://merger-service:5004",
      "AiAssistantService": "http://ai-assistant:5006",
      "AuditDlpService": "http://audit-dlp:5007"
    }
  },
  "AllowedHosts": "*"
}
