{
  "ConnectionStrings": {
    "AuditDlpDb": "Host=localhost;Port=5432;Database=centerpoint_audit_dlp;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "https://auth.centerpoint.com",
    "Audience": "https://api.centerpoint.com",
    "SigningKey": "REPLACE_WITH_A_STRONG_256_BIT_SIGNING_KEY_IN_PRODUCTION",
    "ExpirationMinutes": 15,
    "RefreshExpirationDays": 7
  },

  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },

  "Cors": {
    "AllowedOrigins": "http://localhost:3000;http://localhost:5173"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
