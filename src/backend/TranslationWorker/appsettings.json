{
  "ConnectionStrings": {
    "TranslationDb": "Host=localhost;Port=5432;Database=centerpoint_translation;Username=postgres;Password=postgres"
  },

  "Translation": {
    "S3": {
      "Endpoint": "http://localhost:9000",
      "BucketName": "translations",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "Region": "us-east-1",
      "ForcePathStyle": true
    },
    "Providers": {
      "GoogleProviderService": "http://localhost:5020",
      "MicrosoftProviderService": "http://localhost:5030"
    },
    "MaxFileSizeBytes": 104857600,
    "DownloadTimeoutSeconds": 120
  },

  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "MassTransit": "Information"
      }
    }
  },

  "AllowedHosts": "*"
}
