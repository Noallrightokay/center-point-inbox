{
  "ConnectionStrings": {
    "AiDb": "Host=localhost;Port=5432;Database=centerpoint_inbox;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "https://auth.centerpoint.com",
    "Audience": "https://api.centerpoint.com",
    "SigningKey": "REPLACE_WITH_A_STRONG_256_BIT_SIGNING_KEY_IN_PRODUCTION",
    "ExpirationMinutes": 15,
    "RefreshExpirationDays": 7
  },

  "AiSettings": {
    "OpenAiApiKey": "REPLACE_WITH_OPENAI_API_KEY",
    "OpenAiModel": "gpt-4o",
    "EmbeddingModel": "text-embedding-3-small",
    "MaxChunkTokens": 500,
    "ChunkOverlapTokens": 50,
    "MaxContextChunks": 10,
    "MaxQueryLength": 2000
  },

  "ProviderServices": {
    "GoogleBaseUrl": "http://localhost:5010",
    "MicrosoftBaseUrl": "http://localhost:5020"
  },

  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },

  "Cors": {
    "AllowedOrigins": "http://localhost:3000;http://localhost:5173"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
