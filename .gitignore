# Rust. The desktop crates carry their own rules for generated interface
# assets and Tauri's build output.
target/

# Node
node_modules/
.next/
out/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets. The licence signing key is a .pem and must never be committed —
# the public half is passed to the build as RATA_LICENCE_PUBLIC_KEY instead.
*.pem
*.pfx
.env
.env*.local
